{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": ["web/src", "web/vite.config.ts", "shared", "scripts", "tests/ts"],
  "exclude": ["node_modules", "target", "dist", "spikes"]
}
