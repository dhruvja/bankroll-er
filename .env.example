# Disposable zero-SOL smoke wallets (base58 secret keys). `pnpm smoke -- --execute` creates any
# missing entry in .env. Never fund these with SOL.
SMOKE_PLAYER_1=
SMOKE_PLAYER_2=
SMOKE_PLAYER_3=

# Devnet play-money faucet (base58 secret key). Ships in the web bundle on purpose; fund it with devnet SOL and USDC.
VITE_BANKROLL_FAUCET_SECRET=
