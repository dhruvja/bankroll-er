  "types": [
    {
      "name": "EphemeralTable",
      "docs": [
        "One host's table: an ER-only Ephemeral Account at `[TABLE_SEED, host]`, created by the first",
        "`open_table` and reused in place for that host's later games until it is closed."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "bump",
